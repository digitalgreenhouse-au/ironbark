[Desktop Entry]
Type=Application
Name=Ironbark
GenericName=Music Player
Comment=Play lossless music, from files, folders, playlists and CUE sheets
Exec=Ironbark %F
Icon=ironbark
Terminal=false
Categories=AudioVideo;Audio;Player;
Keywords=music;player;flac;lossless;playlist;
MimeType=audio/flac;audio/x-flac;audio/wav;audio/x-wav;audio/vnd.wave;audio/mpeg;audio/aiff;audio/x-aiff;audio/mp4;audio/x-m4a;audio/ogg;audio/x-vorbis+ogg;audio/opus;audio/x-opus+ogg;audio/x-mpegurl;audio/mpegurl;application/x-cue;
StartupWMClass=Ironbark
